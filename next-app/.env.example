# EmailJS (browser SDK). Values come from the EmailJS dashboard; never commit real values.
# The Vite app read these as VITE_EMAILJS_*; Next.js only exposes NEXT_PUBLIC_* variables to the browser.

# Shared by both forms
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# "Talk Now" project enquiry popup (src/components/ProjectModal.tsx)
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=

# Contact page enquiry form (src/components/ContactForm.tsx): a separate template.
# Template setup: Subject {{subject}} ("New Website Enquiry – Contact Page"), Reply-To {{reply_to}},
# To Email = the same inbox as the Talk Now template. Variables sent: subject, source, name, email,
# reply_to, phone, project_type, message.
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=
