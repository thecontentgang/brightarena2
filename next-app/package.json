{
  "name": "brightarena-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-responsive-images.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "seo:check": "node scripts/validate-seo.mjs",
    "seo:compare": "node scripts/compare-with-vite.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:contact && pnpm images:check && pnpm build && pnpm seo:check",
    "images:check": "node scripts/optimize-images.mjs --check && node scripts/build-responsive-images.mjs --check",
    "images:responsive": "node scripts/build-responsive-images.mjs",
    "test:contact": "node --test scripts/test-contact-form.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@gsap/react": "^2.1.2",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.4.6",
    "ogl": "^1.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.6",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  }
}
